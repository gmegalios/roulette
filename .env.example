AUTH_MODE=off
TLS_CERT_FILE=certs/dev-cert.pem
TLS_KEY_FILE=certs/dev-key.pem

# Change this to microsoft after the Entra app registration is ready.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-the-secret-value
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_REDIRECT_URI=https://localhost:1186/auth/callback
MICROSOFT_POST_LOGOUT_REDIRECT_URI=https://localhost:1186/signed-out
COOKIE_SECURE=true

# Optional: limit access to specific tenant accounts. Comma-separate multiple users.
# MICROSOFT_ALLOWED_USERS=person@example.com
